# ──────────────────────────────────────────────
# Phantom Patch — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/phantom-patch

# JWT Auth
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=24h

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4

# Semgrep (optional)
SEMGREP_APP_TOKEN=

# OWASP ZAP (optional)
ZAP_API_KEY=
ZAP_BASE_URL=http://localhost:8080

# Docker Sandbox
SANDBOX_IMAGE=phantom-sandbox:latest
SANDBOX_TIMEOUT=30000
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
